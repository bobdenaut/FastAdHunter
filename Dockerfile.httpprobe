# syntax=docker/dockerfile:1
#
# Throwaway on-device probe for p2-08: HTTP proxy cost on the RB5009.
#
# NOT a deployable artefact. Same reasoning as Dockerfile.probe — the shipped
# image is distroless and RouterOS exposes no `docker exec`, so the only way to
# measure on that CPU is a second container whose entrypoint *is* the
# measurement. It writes nothing, mounts nothing, listens on nothing reachable
# (client, proxy and origin all sit on the container's own loopback) and exits
# when done; results come back through RouterOS's container log.
#
# The deployed URL tier is baked in as `/corpus` so the rules arms are judged
# against the ruleset this router actually compiles (715 URL rules), not a
# synthetic one. `/data` is never mounted: a probe has no business near the
# live cache.
#
# Build (arm64, legacy docker-archive for RouterOS — see docs/deploy-rb5009.md
# §1: OCI layout makes RouterOS hang at `extracting` forever with no error):
#
#   docker buildx build --platform linux/arm64 -f Dockerfile.httpprobe \
#     -t fah-httpbench:1 -o type=docker,dest=fah-httpbench-arm64.tar .
#   tar -xOf fah-httpbench-arm64.tar manifest.json     # check "Layers"
#   # if blobs/sha256/... then convert:
#   docker run --rm -v "$PWD:/work" quay.io/skopeo/stable copy \
#     --insecure-policy oci-archive:/work/fah-httpbench-arm64.tar \
#     docker-archive:/work/fah-httpbench-rosready.tar:fah-httpbench:1

# Same base and Rust version as Dockerfile, so the compiler and libc match what
# production is built with — otherwise the ARM figures describe a toolchain the
# router never runs.
FROM rust:1.96.0-alpine AS builder

# mimalloc compiles C via the `cc` crate and needs libc headers. The probe
# selects mimalloc explicitly (see crates/fah-http/examples/httpbench.rs) to
# match the shipped binary's allocator.
RUN apk add --no-cache musl-dev

WORKDIR /build
COPY . .

RUN cargo build --release --locked -p fah-http --example httpbench

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /build/target/release/examples/httpbench /httpbench
COPY .probe-corpus/production /corpus

# Root, like the production image, purely so nothing here can fail on a
# permission difference the measurement would then have to explain.
USER 0:0

ENTRYPOINT ["/httpbench", "/corpus"]
