# syntax=docker/dockerfile:1
#
# Throwaway on-device probe for p3-10 Track B: SNI splice throughput on the
# RB5009.
#
# NOT a deployable artefact. Same reasoning as Dockerfile.probe and
# Dockerfile.httpprobe — the shipped image is distroless and RouterOS exposes
# no `docker exec`, so the only way to measure on that CPU is a second
# container whose entrypoint *is* the measurement. It writes nothing, mounts
# nothing, listens on nothing reachable (client, splice proxy and origin all
# sit on the container's own loopback) and exits when done; results come back
# through RouterOS's container log.
#
# Why this exists: `docs/code-review/phase3/p3-10-track-b1-x86.md` records that
# the x86 dev box cannot resolve the splice rows — `through_splice` moved 44 %
# between two runs of identical code, and `splicebench`'s own ranking metric
# swung from +25.9 % to +12.5 % across a +10 % decision threshold. Those rows
# carry W1, the workload that ships. This probe measures them on the CPU the
# budgets are written for, without deploying the Phase 3 build.
#
# No corpus: `splicebench` builds its own origin, proxy and client in process
# and needs no ruleset on disk. `/data` is never mounted — a probe has no
# business near the live cache.
#
# The binary is named `splicebench`, not `fastadhunter`. `/tool/profile
# cpu=all` keys on the process name, so a probe sharing the production binary's
# name could not be told apart from it (docs/routeros-traps.md §On-device
# measurement needs its own container).
#
# Build (arm64, legacy docker-archive for RouterOS — see docs/deploy-rb5009.md
# §1: OCI layout makes RouterOS hang at `extracting` forever with no error):
#
#   docker buildx build --platform linux/arm64 -f Dockerfile.splicebench \
#     -t fah-splicebench:1 -o type=docker,dest=fah-splicebench-arm64.tar .
#   tar -xOf fah-splicebench-arm64.tar manifest.json     # check "Layers"
#   # if blobs/sha256/... then convert:
#   docker run --rm -v "$PWD:/work" quay.io/skopeo/stable copy \
#     --insecure-policy oci-archive:/work/fah-splicebench-arm64.tar \
#     docker-archive:/work/fah-splicebench-rosready.tar:fah-splicebench:1

# Same base and Rust version as Dockerfile, so the compiler and libc match what
# production is built with — otherwise the ARM figures describe a toolchain the
# router never runs.
FROM rust:1.96.0-alpine AS builder

# mimalloc compiles C via the `cc` crate and needs libc headers. The probe
# selects mimalloc explicitly (see crates/fah-http/examples/splicebench.rs) to
# match the shipped binary's allocator.
RUN apk add --no-cache musl-dev

WORKDIR /build
COPY . .

RUN cargo build --release --locked -p fah-http --example splicebench

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /build/target/release/examples/splicebench /splicebench

# Root, like the production image, purely so nothing here can fail on a
# permission difference the measurement would then have to explain.
USER 0:0

# Defaults match the x86 runs recorded in p3-10-track-b1-x86.md so the two are
# comparable: 64 MiB per connection, 32 MiB worst-case budget. `--reps 15`
# rather than the built-in 5 — at 5 the same candidate spanned 214.9 to
# 1361.3 MiB/s within one run. Override with `cmd` on /container/add.
ENTRYPOINT ["/splicebench"]
CMD ["--reps", "15"]
