/target
**/*.rs.bk
*.pdb

# Build artifacts — image tarballs produced by docs/deploy-rb5009.md §1.
# Regenerable from any commit; never worth 12 MB of history.
*.tar

# Local editor settings — contains the API key in plaintext, never commit.
.vscode/

# p2-08 probe: third-party lists (EasyList is GPLv3 and changes daily) and
# the throwaway image built from them. Rebuild via Dockerfile.probe.
/.probe-corpus/
fah-urlbench-*.tar

# tui-monitor: holds the live bearer token. Copy config.example.toml instead.
tui-monitor/config.toml

# Dashboard frontend (p5-05): npm install output and the Vite build directory.
# The bundle is produced by the Docker `frontend` stage; it is never committed.
dashboard/frontend/node_modules/
dashboard/frontend/dist/

# Browser-verification scratch (Playwright MCP screenshots/traces). p5-05 ships
# no Playwright; this only keeps a verification run out of the tree.
.playwright-mcp/

# p3-06 smoke runs (plan/wip/phase3/p3-06-smoke-plan.md): local FastAdHunter
# stores — hold ca-key.pem, api-key.pem, apikey, auth-hash — plus the origin
# certificates and exported CAs. Recreated from scratch by every session.
/smoke*/
/smoke*-ca*.pem
/p[13]*.crt
/p[13]*.key
/p[13]*.der

# The rules above are root-anchored and never matched the probe's own smoke
# sessions, which live under docs/code-review/. A `git add -A` there staged 18
# private-key blocks before a scan caught them. The per-session work/ directory
# is the store — CA key, API key, session secret — and is never committed; the
# layer directories beside it are committed evidence and stay tracked.
docs/code-review/**/smoke-*/work/

# smoke/after-interception.mjs boots one throwaway store per row under its
# --out/work/, so the rule above hides the whole store. The names below are
# the secrets a store holds — config/: ca-key.pem, api-key.pem, apikey,
# auth-hash; data/: session-secret; engine.log prints the generated API key
# once — ignored at any depth of any smoke session as a second line, for a
# driver that ever writes a store outside work/. Reports, public certificates,
# documents and run logs stay addable.
docs/code-review/**/smoke-*/**/ca-key.pem
docs/code-review/**/smoke-*/**/api-key.pem
docs/code-review/**/smoke-*/**/apikey
docs/code-review/**/smoke-*/**/auth-hash
docs/code-review/**/smoke-*/**/session-secret
docs/code-review/**/smoke-*/**/session-secret.tmp
docs/code-review/**/smoke-*/**/engine.log

# p3-06 campaign 2: the P10 origin. origin-root/ is ~115 MB of random test
# objects, regenerable in seconds; origin.key is the origin's private key.
docs/code-review/**/campaign2/origin-root/
docs/code-review/**/campaign2/origin.key

# A vitest run started from the repo root instead of dashboard/frontend drops
# its cache at ./node_modules/.vite/vitest/. Never tracked, at any depth.
node_modules/

# Soak collector churn: the hourly pulls, the run log and the bytecode.
# The README, the collector script and the runner stay tracked.
# Each pull's meta.json already carries its own errors.
__pycache__/
docs/code-review/**/soak-*/collector.log
docs/code-review/**/soak-*/pulls/
