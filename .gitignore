/target
**/*.rs.bk
*.pdb

# Build artifacts — image tarballs produced by docs/deploy-rb5009.md §1.
# Regenerable from any commit; never worth 12 MB of history.
*.tar

# Local editor settings — contains the API key in plaintext, never commit.
.vscode/

# Phase under active work — internal scratch surface. `plan/open` (roadmap) and
# `plan/closed` (record) stay tracked; the phase-close commit moves files
# straight from one to the other. Note plan/wip/phase1.5 predates this rule and
# remains in history.
plan/wip/
!plan/wip/.gitkeep
