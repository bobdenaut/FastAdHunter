/target
**/*.rs.bk
*.pdb

# Build artifacts — image tarballs produced by docs/deploy-rb5009.md §1.
# Regenerable from any commit; never worth 12 MB of history.
*.tar

# Local editor settings — contains the API key in plaintext, never commit.
.vscode/

# p2-08 probe: third-party lists (EasyList is GPLv3 and changes daily) and
# the throwaway image built from them. Rebuild via Dockerfile.probe.
/.probe-corpus/
fah-urlbench-*.tar

# tui-monitor: holds the live bearer token. Copy config.example.toml instead.
tui-monitor/config.toml

# Dashboard frontend (p5-05): npm install output and the Vite build directory.
# The bundle is produced by the Docker `frontend` stage; it is never committed.
dashboard/frontend/node_modules/
dashboard/frontend/dist/

# Browser-verification scratch (Playwright MCP screenshots/traces). p5-05 ships
# no Playwright; this only keeps a verification run out of the tree.
.playwright-mcp/
